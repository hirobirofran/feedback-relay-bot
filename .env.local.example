# LINE Messaging API
LINE_CHANNEL_SECRET=（LINE Developers から取得する Channel Secret）
LINE_CHANNEL_ACCESS_TOKEN=（LINE Developers から取得する Channel Access Token）

# Gemini (AI Studio)
GEMINI_API_KEY=（Google AI Studio から取得した API キー）
GEMINI_MODEL=gemini-2.5-flash

# GitHub
GITHUB_TOKEN=（Fine-grained PAT、対象リポジトリの Issues 権限のみ）
GITHUB_OWNER=hirobirofran
GITHUB_REPO=food-inventory-app

# Upstash Redis
UPSTASH_REDIS_REST_URL=（Upstash コンソールから取得）
UPSTASH_REDIS_REST_TOKEN=（Upstash コンソールから取得）

# Auth (LINE userId ホワイトリスト)
# カンマ区切り。最初は本人 1 人で開始。Phase 2 で家族を追加する。
ALLOWED_LINE_USER_IDS=U1234abcd,U5678efgh
# 表示名マップ（Issue 本文の「報告者」欄などで使用）
USER_DISPLAY_NAME_MAP={"U1234abcd":"本人"}

# App
NEXT_PUBLIC_APP_ENV=production
